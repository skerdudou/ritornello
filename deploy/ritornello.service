[Unit]
Description=ritornello (radio internet + CD)
After=network-online.target sound.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/bin/ritornello-core
Restart=always
RestartSec=2
# Unprivileged service: the `ritornello` system user is created by
# deploy/deploy.sh. Nothing in the code needs root — only device access,
# granted by groups: sound (audio), remote control (input), CD drive
# (cdrom), HDMI console /dev/tty1 (tty), and the firmware mailbox
# /dev/vcio (video).
#
# `video` is read-only in practice: it is what lets `vcgencmd get_throttled`
# report an under-voltage that occurred since boot, a sticky flag the kernel
# exposes through no sysfs or procfs file. Granted here rather than with
# `usermod -aG` on the account, like its four neighbours: this way the
# privilege belongs to **this service's processes**, not to anything that
# ever runs as `ritornello`. Without it the flag stays `null` and the System
# tab shows "—", the same as any absent sensor; nothing else breaks.
User=ritornello
SupplementaryGroups=audio input cdrom tty video
# /run/ritornello (plugin and mpv sockets) and /var/lib/ritornello
# (persisted state) are created and owned by the service user.
RuntimeDirectory=ritornello
StateDirectory=ritornello
Environment=RITORNELLO_STATE=/var/lib/ritornello/state.json
# Hardening. ProtectSystem=strict mounts everything read-only except the
# two directories above — /etc/ritornello must stay writable: the radio
# and generic-input plugins persist stations.toml and input-bindings.toml
# there (atomic write: .tmp then rename, hence write access to the
# directory itself, set up by deploy.sh). No PrivateDevices: the whole
# point of the groups above is /dev access.
#
# PrivateTmp=true is what makes `strict` liveable: it mounts /tmp read-only
# too, and mpv's PulseAudio probe writes there before falling back to ALSA —
# `Failed to create random directory /tmp/pulse-XXXXXX: Read-only file
# system`, an ERROR line in the journal at every start of a device that plays
# through ALSA and never needed pulse at all. A private /tmp gives that probe
# somewhere to write, and keeps the isolation rather than opening the real one.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/etc/ritornello
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
